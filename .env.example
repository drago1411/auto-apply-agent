# ==========================================
# Job Application Agent Configuration
# ==========================================

# Server & Dashboard
PORT=3000
HOST=127.0.0.1
API_TOKEN=replace-with-a-long-random-token
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PORTAL_PASSWORD=
NODE_ENV=development

# Relative Paths to User Files
PROFILE_PATH=./profile.json
DATABASE_PATH=./data/jobs.db

# Gmail Connection Option 1: Gmail App Password (Easiest - No Google Cloud Console needed)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=abcdefghijklmnop

# Gmail Connection Option 2: Google Cloud OAuth2
GMAIL_CREDENTIALS_PATH=./credentials.json
GMAIL_TOKEN_PATH=./token.json

# Orchestrator & Polling
POLL_INTERVAL_MINUTES=10
AUTO_MATCH_ON_SCAN=true
AUTO_APPLY_ATS=true

# ATS Engine (Playwright)
# CDP attach: run scripts\launch-chrome-debug.bat first, then start the agent.
# Change this only if you modified the port in the bat file.
CDP_URL=http://localhost:9222
HEADLESS_ATS=false
RANDOM_DELAY_MIN_MS=1500
RANDOM_DELAY_MAX_MS=3800
MAX_ATS_APPLICATIONS_PER_RUN=5

# Stealth Mode (anti-bot fingerprint evasion)
# leave blank (default): attach to real Chrome over CDP — recommended for daily use.
# launch: start a standalone playwright-extra + stealth-plugin Chromium instead.
#         Use this when Cloudflare / DataDome is blocking the CDP session.
STEALTH_MODE=

# Matcher Settings
MIN_MATCH_SCORE=60
